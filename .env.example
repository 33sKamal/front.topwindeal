# Local dev (Nuxt on 3112, API via Nitro proxy — match APP_PORT in dashboard .env)
NUXT_PUBLIC_API_URL=
NUXT_PUBLIC_DASHBOARD_URL=http://localhost:9485
NUXT_DEV_API_PROXY_TARGET=http://127.0.0.1:9485/api

# Production static build (see Source code/DEPLOY.md)
# NUXT_SSR=false
# NUXT_PUBLIC_API_URL=https://dashboard.topwindeal.com
# NUXT_PUBLIC_DASHBOARD_URL=https://dashboard.topwindeal.com
